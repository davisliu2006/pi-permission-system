{
  "name": "@davisliu2006/pi-permission-system",
  "version": "0.4.0",
  "description": "Permission enforcement extension for the Pi coding agent.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "permissions",
    "pi-permissions"
  ],
  "author": "davisliu2006",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davisliu2006/pi-permission-system.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/davisliu2006/pi-permission-system/main/images/image.webp"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.78.0",
    "@earendil-works/pi-coding-agent": ">=0.78.0",
    "@earendil-works/pi-tui": ">=0.78.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.1",
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@earendil-works/pi-tui": "^0.78.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
